# Deixe vazio para usar o modo de demonstração local (dados só no navegador).
# Preencha com o ID do app no Base44 para usar autenticação, banco e funções reais.
VITE_BASE44_APP_ID=
# Opcional: URL do servidor Base44, se diferente do padrão.
VITE_BASE44_SERVER_URL=

# Apenas no modo local:
# "false" esconde o conteúdo em rascunho (simula produção: só o publicado aparece).
VITE_LOCAL_DEMO_PREVIEW=true
# Senha da conta administradora de demonstração (admin@vereda.local).
VITE_LOCAL_ADMIN_PASSWORD=vereda-admin
