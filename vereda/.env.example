# Copie para .env.local e preencha. Nunca faça commit de .env.local.

# URL do projeto Supabase (Painel → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" (pode ir para o navegador; protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role": SOMENTE no servidor. Nunca use em código do navegador
# nem em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (usada nos links de confirmação e recuperação de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexão direta com o Postgres — apenas para `npm run db:migrate` e testes de banco.
# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=
