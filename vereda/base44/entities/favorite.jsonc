// Gerado para o Vereda. RLS: privado do usuário
{
  "name": "Favorite",
  "description": "Referência bíblica favorita (privado).",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    }
  },
  "required": [
    "reference"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}
