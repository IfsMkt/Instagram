// Gerado para o Vereda. RLS: privado do usuário — escrita apenas pelo backend
{
  "name": "XPEvent",
  "description": "Registro de XP concedido.",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "amount": {
      "type": "integer"
    },
    "reason": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "local_date": {
      "type": "string",
      "format": "date"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_email",
    "amount"
  ],
  "rls": {
    "create": false,
    "read": {
      "data.owner_email": "{{user.email}}"
    },
    "update": false,
    "delete": false
  }
}
