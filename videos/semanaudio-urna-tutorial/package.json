{
  "name": "semanaudio-urna-tutorial",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "analyze": "bash scripts/analyze.sh",
    "prep-audio": "bash scripts/prep-audio.sh",
    "music": "python3 scripts/music.py",
    "studio": "remotion studio src/index.ts",
    "preview": "remotion render src/index.ts UrnaTutorial out/previa-urna-tutorial.mp4 --codec h264 --crf 26 --scale 0.5",
    "render": "node scripts/render-final.mjs",
    "still": "remotion still src/index.ts UrnaTutorial out/still.png",
    "prep-source": "bash scripts/prep-source.sh",
    "render:nativo": "node scripts/render-final.mjs --nativo"
  },
  "dependencies": {
    "@remotion/cli": "4.0.364",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.364"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
